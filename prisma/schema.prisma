model Ticket {
  id String @id @default(cuid())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId Int
  ticketNumber Int
  ticketCategory TicketCategory? @relation(fields: [ticketCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketCategoryId String?
  title String
  status TicketStatus @default(PENDING)
  priority TicketPriority
  customer User @relation("customerTickets", fields: [customerId], references: [id], onDelete: Restrict)
  customerId String
  agent User? @relation("agentTickets", fields: [assignedAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedAgentId String?
  aiSummarizedData Json?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketContent TicketContent?
  ticketWithTags TicketWithTags[]

  @@index([organizationId, createdAt]) // when no filter, retrieve ALL tickets based on organization
  @@index([organizationId, status]) // When filter is applied, status index is included
  @@index([organizationId, priority]) // When filter is applied, priority index is included
  @@index([organizationId, customerId]) // When filter is applied, the customer ID relation is included
  @@index([organizationId, assignedAgentId]) // When filter is applied, the agent ID relation is included
  @@unique([organizationId, ticketNumber])
}

model TicketContent {
  id String @id @default(cuid())
  ticket Ticket @relation(fields: [ticketId], references: [id])
  ticketId String @unique
  content String
  isInternal Boolean @default(false)
  readAt DateTime?
}

model TicketCategory {
  id String @id @default(cuid())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId Int
  name String
  color String?
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdById])
}

model TicketTag {
  id String @id @default(cuid())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId Int
  name String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketWithTags TicketWithTags[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdById])
}

model TicketWithTags {
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ticketId String
  ticketTag TicketTag @relation(fields: [ticketTagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ticketTagId String

  @@id([ticketId, ticketTagId])
}



